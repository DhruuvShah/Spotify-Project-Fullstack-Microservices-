# Google OAuth2 credentials (from Google Cloud Console)
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# Email sender address (must match the OAuth2 account)
EMAIL_USER=

# RabbitMQ connection string
RABBITMQ_URI=

# MongoDB connection string (added in Phase 4)
MONGO_URI=

# Server port (optional, defaults to 3001)
PORT=3001
